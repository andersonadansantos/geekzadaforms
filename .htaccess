# =====================================================================
#  GeekZada Forms - Apache/XAMPP local
#
#  URL da aplicacao : http://localhost/geekzadaforms/services/formulario/inscricoes/
#  URL da API        : http://localhost/geekzadaforms/services/formulario/inscricoes/api/
#
#  O codigo-fonte (src/, node_modules/, api/) e o build (dist/) Dividem
#  a mesma pasta, e este arquivo serve o build bloqueando o resto.
#
#  IMPORTANTE: o build e servido de dist/, e o index.html da raiz do
#  projeto NAO e sobrescrito. Aquele e o arquivo de entrada do Vite
#  (aponta para ./src/index.tsx); se o build copiasse o bundle por cima
#  dele, o proximo "npm run build" passaria a empacotar o bundle antigo
#  em vez do codigo-fonte. Foi exatamente esse bug.
#
#  O .htaccess de producao vive em tools/htaccess.producao e tem outro
#  layout (app na raiz do dominio). Os dois NAO sao o mesmo arquivo.
# =====================================================================

# Build do Vite e servido na raiz da aplicacao.
DirectoryIndex dist/index.html

# ---------------------------------------------------------------------
#  Limites de upload de anexos
#
#  Cosplayer Performance aceita video de ate 150 MB e ate 3 fotos de
#  50 MB cada. Numa inscricao com tudo no limite o corpo passa de 300 MB,
#  entao o post_max_size fica acima disso. upload_max_filesize cobre o
#  maior arquivo individual (150 MB).
# ---------------------------------------------------------------------
<IfModule php_module>
    php_value upload_max_filesize 150M
    php_value post_max_size 320M
    php_value max_input_time 600
    php_value max_execution_time 600
</IfModule>

# ---------------------------------------------------------------------
#  Cabecalho Authorization para a API
#
#  O Apache com mod_php descarta o cabecalho "Authorization" antes de
#  chegar ao PHP. Sem isto, o token de sessao do painel nunca chega e
#  toda chamada autenticada volta 401. O SetEnvIf abaixo recoloca o
#  cabecalho em HTTP_AUTHORIZATION.
# ---------------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# ---------------------------------------------------------------------
#  Bloqueio de arquivos de desenvolvimento e de configuracao
# ---------------------------------------------------------------------
<FilesMatch "\.(sql|log|ini|env|lock|md|txt|ts|tsx|json|jsonc)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------
#  Arquivos ocultos e segredos
#
#  O Apache nao bloqueia dotfiles por padrao, e api/.secret.key (chave
#  de criptografia das senhas do painel) comeca com ponto. Precisa ser
#  bloqueado explicitamente: sem isto, qualquer pessoa na rede local
#  baixa a chave e decifra todas as senhas do painel.
# ---------------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(key|pem|crt|p12|jks)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(config|forms|auth|seed_admin|gen_secret)\.php$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------
#  Roteamento
# ---------------------------------------------------------------------
# ---------------------------------------------------------------------
#  Diretorios de desenvolvimento: nunca sao servidos
#
#  As regras por extensao acima resolvem quase tudo, mas nao pegam um
#  .png dentro de src/ (o logo do projeto, por exemplo). O Apache so
#  precisa publicar o build de dist/.
#
#  Duas camadas, porque um RewriteRule nao basta para deploy/: aquela pasta
#  carrega o .htaccess de PRODUCAO, que assume a raiz de um dominio, e as
#  regras dele passam a valer dentro dela. O RedirectMatch roda antes do
#  mod_rewrite, entao nega o acesso sem depender do que o .htaccess de cada
#  subpasta fizer.
#
#  O padrao do RedirectMatch leva o caminho INTEIRO, porque ele e avaliado
#  contra a URL e nao contra o caminho relativo a esta pasta.
# ---------------------------------------------------------------------
RedirectMatch 403 "^/geekzadaforms/services/formulario/inscricoes/(src|node_modules|tools|deploy|dist-hostinger)(/|$)"

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /geekzadaforms/services/formulario/inscricoes/

    # Segunda camada, por nome relativo a esta pasta. Cobre o pedido quando
    # o RedirectMatch acima esta indisponivel (mod_alias fora do build).
    RewriteRule ^(src|node_modules|tools|deploy|dist-hostinger)(/|$) - [F,L]

    # A API em PHP precisa ser executada normalmente.
    RewriteRule ^api/ - [L]

    # A pasta dist/ e servida como esta.
    RewriteRule ^dist/ - [L]

    # Instalador: removido. Quem instala agora e o Dockerfile.
    #
    # A pasta install/ e a rota ^install foram removidas quando o deploy
    # passou a acontecer dentro do container: o schema entra pelo init do
    # MariaDB e os usuarios do painel sao criados pelo seed_admin.php, que
    # o entrypoint da aplicacao roda na subida. Nao ha mais nada para
    # perguntar numa tela, e um instalador HTTP exposto e uma porta aberta -
    # quem o achasse recriava o schema do banco.
    #
    # Para o XAMPP local, importe api/schema.sql no phpMyAdmin e rode
    # "php api/seed_admin.php". Ver README.md.

    # Arquivos gerados pelo build (assets com hash, CSS, JS).
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

    # Qualquer outra rota cai no index.html do build.
    # A navegacao usa hash (#kpop), mas isso cobre acesso direto.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ dist/index.html [L]
</IfModule>

# ---------------------------------------------------------------------
#  Protecoes adicionais
# ---------------------------------------------------------------------
Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>